# Vercel Postgres — estas variables las inyecta Vercel automáticamente
# al vincular una base de datos en el dashboard (Storage > Postgres).
# Para desarrollo local, cópialas desde: Vercel Dashboard > Storage > tu BD > .env.local

POSTGRES_PRISMA_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DBNAME]?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://[USER]:[PASSWORD]@[HOST]/[DBNAME]"

# NextAuth
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini — obtén tu API key en https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
