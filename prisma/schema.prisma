generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
  schemas   = ["scraper"]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  description String?  @db.Text
  website     String?
  ai_context  String   @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users User[]

  @@map("companies")
  @@schema("scraper")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  username      String?
  password_hash String
  status        String   @default("inactive")
  role          String   @default("user")
  company_id    String?
  company       Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  favorites     PlaceFavorite[]
  reactions     PlaceReaction[]
  notes         PlaceNote[]
  activities    PlaceActivity[]
  prospectLists ProspectList[]

  @@map("users")
  @@schema("scraper")
}

model ProspectList {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  created_by  Int
  created_at  DateTime @default(now())

  user  User               @relation(fields: [created_by], references: [id])
  items ProspectListItem[]

  @@map("prospect_lists")
  @@schema("scraper")
}

model ProspectListItem {
  id       Int    @id @default(autoincrement())
  list_id  String
  place_id String
  rank     Int?
  reason   String? @db.Text

  list  ProspectList @relation(fields: [list_id],  references: [id], onDelete: Cascade)
  place Place        @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@unique([list_id, place_id])
  @@map("prospect_list_items")
  @@schema("scraper")
}

model Place {
  id                    String   @id @default(cuid())
  input_id              String?
  link                  String?
  title                 String?
  category              String?
  address               String?
  open_hours            Json?
  popular_times         Json?
  website               String?
  phone                 String?
  email                 String?
  plus_code             String?
  review_count          Int?
  review_rating         Decimal? @db.Decimal(3, 1)
  reviews_per_rating    Json?
  latitude              Decimal? @db.Decimal(10, 7)
  longitude             Decimal? @db.Decimal(10, 7)
  cid                   String?
  status                String?
  descriptions          String?  @db.Text
  reviews_link          String?
  thumbnail             String?
  timezone              String?
  price_range           String?
  data_id               String?
  place_id              String?  @unique
  images                Json?
  reservations          Json?
  order_online          Json?
  menu                  Json?
  owner                 Json?
  complete_address      Json?
  about                 Json?
  user_reviews          Json?
  user_reviews_extended Json?
  emails                Json?
  batch_tag             String?
  city                  String?
  country               String?
  lead_score            Int?
  lead_temperature      String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  favorites     PlaceFavorite[]
  reactions     PlaceReaction[]
  notes         PlaceNote[]
  activities    PlaceActivity[]
  prospectItems ProspectListItem[]

  @@map("places")
  @@schema("scraper")
}

model PlaceFavorite {
  id         Int      @id @default(autoincrement())
  place      Place    @relation(fields: [place_id], references: [id], onDelete: Cascade)
  place_id   String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  created_at DateTime @default(now())

  @@unique([place_id, user_id])
  @@map("place_favorites")
  @@schema("scraper")
}

model PlaceReaction {
  id         Int      @id @default(autoincrement())
  place      Place    @relation(fields: [place_id], references: [id], onDelete: Cascade)
  place_id   String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  emoji      String
  created_at DateTime @default(now())

  @@unique([place_id, user_id, emoji])
  @@map("place_reactions")
  @@schema("scraper")
}

model PlaceNote {
  id         Int      @id @default(autoincrement())
  place      Place    @relation(fields: [place_id], references: [id], onDelete: Cascade)
  place_id   String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  username   String?
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("place_notes")
  @@schema("scraper")
}

model PlaceActivity {
  id          Int      @id @default(autoincrement())
  place       Place    @relation(fields: [place_id], references: [id], onDelete: Cascade)
  place_id    String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     Int
  username    String?
  type        String   // call | email | whatsapp | meeting | contacted | ai_action | other
  content     String?  @db.Text
  happened_at DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([place_id, happened_at(sort: Desc)])
  @@map("place_activities")
  @@schema("scraper")
}
